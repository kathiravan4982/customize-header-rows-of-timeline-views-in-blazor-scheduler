<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Blazor.Schedule" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="33.2.15" />
  </ItemGroup>

</Project>
